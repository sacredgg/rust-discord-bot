# Токен бота из https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Очередь показывается только если задан ключ BattleMetrics API
# (публичный API BattleMetrics теперь платный). Оставь пустым, если нет ключа.
BATTLEMETRICS_TOKEN=

# Запасной источник данных по HTTPS (нужен, если UDP-запросы заблокированы).
# Бесплатный ключ Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Таймаут запроса к серверу в секундах
QUERY_TIMEOUT=1

# Общий лимит ответа на команду (сек), чтобы оффлайн-серверы отвечали быстро
QUERY_ANSWER_LIMIT=2

# Кэш результатов в секундах — повторные запросы мгновенные
CACHE_TTL=8
